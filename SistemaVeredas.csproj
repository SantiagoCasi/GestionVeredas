<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>9dbd2954-f4f9-4fb1-9bd1-06efa954857b</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.20" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.20">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="9.0.12" />
  </ItemGroup>

  <!-- El proyecto de pruebas está en una subcarpeta: no se compila ni se publica con la app (SPEC-004). -->
  <ItemGroup>
    <Compile Remove="SistemaVeredas.Tests\**" />
    <Content Remove="SistemaVeredas.Tests\**" />
    <EmbeddedResource Remove="SistemaVeredas.Tests\**" />
    <None Remove="SistemaVeredas.Tests\**" />

    <Content Remove="TestResults\**" />
    <None Remove="TestResults\**" />
  </ItemGroup>

</Project>
