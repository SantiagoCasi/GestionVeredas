@model SistemaVeredas.Models.Proveedor

@{
    ViewData["Title"] = "Editar proveedor";
}

<div class="mx-auto" style="max-width: 640px;">
    <a asp-action="Index" class="small text-decoration-none">&larr; Volver a la lista</a>
    <h1 class="h3 mb-1">Editar proveedor</h1>
    <div class="mb-3"></div>

    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />
        <section class="form-seccion">
            <div class="form-seccion-head">Datos del proveedor</div>
            <div class="form-seccion-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Nombre" class="form-label"></label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Apellido" class="form-label"></label>
                        <input asp-for="Apellido" class="form-control" />
                        <span asp-validation-for="Apellido" class="text-danger"></span>
                    </div>
                    <div class="col-md-12">
                        <label asp-for="Telefono" class="form-label"></label>
                        <input asp-for="Telefono" class="form-control" />
                        <span asp-validation-for="Telefono" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </section>

        <div class="d-flex justify-content-end gap-2 mb-4">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <input type="submit" value="Guardar cambios" class="btn btn-guardar" />
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
