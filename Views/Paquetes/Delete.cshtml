@model SistemaVeredas.Models.Paquete

@{
    ViewData["Title"] = "Eliminar paquete";

    // RN-11: al eliminar el paquete sus veredas no se borran, quedan sin paquete.
    var cantidad = ViewData["CantidadVeredas"] as int? ?? 0;
    var avisoVeredas = cantidad switch
    {
        0 => "Este paquete no tiene veredas.",
        1 => "Este paquete tiene 1 vereda. No se borra: queda sin paquete.",
        _ => $"Este paquete tiene {cantidad} veredas. No se borran: quedan sin paquete."
    };
}

<h1>Eliminar paquete</h1>

<h3>¿Seguro que querés eliminar el paquete «@Model.Nombre»?</h3>
<div class="alert alert-warning">@avisoVeredas</div>
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Nombre)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Nombre)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Fecha)
        </dt>
        <dd class = "col-sm-10">
            @Model.Fecha.ToString("dd/MM/yyyy")
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Proveedor)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Proveedor!.Nombre)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Observacion)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Observacion)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Eliminar" class="btn btn-danger" /> |
        <a asp-action="Index">Volver a la lista</a>
    </form>
</div>
