@model SistemaVeredas.Models.Paquete

@{
    ViewData["Title"] = "Eliminar paquete";

    // RN-11: al eliminar el paquete sus veredas no se borran, quedan sin paquete.
    var cantidad = ViewData["CantidadVeredas"] as int? ?? 0;
    var avisoVeredas = cantidad switch
    {
        0 => "Este paquete no tiene veredas.",
        1 => "Este paquete tiene 1 vereda. No se borra: queda sin paquete.",
        _ => $"Este paquete tiene {cantidad} veredas. No se borran: quedan sin paquete."
    };
}

<div class="mx-auto" style="max-width: 640px;">
    <a asp-action="Index" class="small text-decoration-none">&larr; Volver a la lista</a>
    <h1 class="h3 mb-1">Eliminar paquete</h1>
    <p class="text-muted mb-3">¿Seguro que querés eliminar el paquete «@Model.Nombre»?</p>
    <div class="alert alert-warning">@avisoVeredas</div>

    <section class="form-seccion">
        <div class="form-seccion-body py-2">
            <div class="dato-fila"><span class="k">@Html.DisplayNameFor(model => model.Nombre)</span><span class="v">@Html.DisplayFor(model => model.Nombre)</span></div>
            <div class="dato-fila"><span class="k">@Html.DisplayNameFor(model => model.Fecha)</span><span class="v">@Model.Fecha.ToString("dd/MM/yyyy")</span></div>
            <div class="dato-fila"><span class="k">@Html.DisplayNameFor(model => model.Proveedor)</span><span class="v">@(Model.Proveedor?.Nombre ?? "—")</span></div>
            <div class="dato-fila"><span class="k">@Html.DisplayNameFor(model => model.Observacion)</span><span class="v">@Html.DisplayFor(model => model.Observacion)</span></div>
        </div>
    </section>

    <form asp-action="Delete" class="d-flex justify-content-end gap-2 mb-4">
        <input type="hidden" asp-for="Id" />
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        <input type="submit" value="Eliminar" class="btn btn-danger" />
    </form>
</div>
