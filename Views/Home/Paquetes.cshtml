@model List<SistemaVeredas.Models.Paquete>
@{
    ViewData["Title"] = "Paquetes";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <a asp-action="Index" class="small text-decoration-none">&larr; Inicio</a>
        <h1 class="h3 mb-0">Paquetes <span class="text-muted fs-6">(@Model.Count)</span></h1>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Paquetes" asp-action="Index" class="btn btn-outline-secondary btn-sm">Ver como tabla</a>
        <a asp-controller="Paquetes" asp-action="Create" class="btn btn-primary btn-sm">+ Nuevo paquete</a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="empty-state">Todavía no hay paquetes cargados.</div>
}
else
{
    <div class="row g-3">
        @foreach (var p in Model)
        {
            var totales = PaqueteService.CalcularTotales(p.Veredas.Select(v => new VeredaTotales(v.Estado, v.TotalM2, v.TotalCordonM3)));
            var total = totales.Cantidad;
            var finalizadas = totales.Finalizadas;
            var avance = totales.PorcentajeAvance;
            var superficie = totales.TotalM2;

            <div class="col-12 col-lg-6">
                <div class="card data-card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div>
                                <h2 class="h5 card-title mb-0">@p.Nombre</h2>
                                <div class="text-muted small">
                                    @p.Fecha.ToString("dd/MM/yyyy") &middot;
                                    @(p.Proveedor == null ? "Sin proveedor" : $"{p.Proveedor.Nombre} {p.Proveedor.Apellido}".Trim())
                                </div>
                            </div>
                            <span class="badge text-bg-light border">@total veredas</span>
                        </div>

                        <div class="row text-center my-3 g-2">
                            <div class="col-4"><div class="mini-stat"><strong>@total</strong><span>Veredas</span></div></div>
                            <div class="col-4"><div class="mini-stat"><strong>@finalizadas</strong><span>Finalizadas</span></div></div>
                            <div class="col-4"><div class="mini-stat"><strong>@MedicionService.FormatearNumero(superficie, 2)</strong><span>m²</span></div></div>
                        </div>

                        <div class="d-flex justify-content-between small text-muted mb-1">
                            <span>Avance</span><span>@avance%</span>
                        </div>
                        <div class="progress mb-3" role="progressbar" aria-valuenow="@avance" aria-valuemin="0" aria-valuemax="100" style="height:8px">
                            <div class="progress-bar bg-primary" style="width:@avance%"></div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(p.Observacion))
                        {
                            <p class="small text-muted">@p.Observacion</p>
                        }

                        @if (p.Veredas.Any())
                        {
                            <ul class="list-group list-group-flush paquete-veredas">
                                @foreach (var v in p.Veredas.OrderBy(v => v.Calle).ThenBy(v => v.Altura))
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                        <a asp-controller="Veredas" asp-action="Details" asp-route-id="@v.Id" class="text-decoration-none"><span class="text-muted">#@v.Codigo</span> @v.Direccion</a>
                                        <span class="badge @v.Estado.BadgeClass()">@v.Estado.GetDisplayName()</span>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="small text-muted mb-0">Este paquete todavía no tiene veredas asignadas.</p>
                        }
                    </div>
                    <div class="card-footer bg-transparent d-flex gap-2">
                        <a asp-controller="Paquetes" asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Ver detalle</a>
                        <a asp-controller="Paquetes" asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
