@model SistemaVeredas.Models.TipoSuelo

@{
    ViewData["Title"] = "Delete";

    // RN-13: si alguna vereda lo usa, no se elimina: se marca como no disponible.
    var enUso = ViewData["VeredasQueLoUsan"] as int? ?? 0;
    var textoVeredas = enUso == 1 ? "1 vereda" : $"{enUso} veredas";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>TipoSuelo</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Tipo)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Tipo)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Medida)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Medida)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Color)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Color)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Disponible)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Disponible)
        </dd>
    </dl>
    
    @if (enUso > 0)
    {
        <div class="alert alert-warning">
            Este tipo de suelo lo usan @textoVeredas, así que no se puede eliminar. Si ya no se consigue, marcalo como no disponible.
        </div>
    }

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="@(enUso > 0 ? "Marcar como no disponible" : "Delete")" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
