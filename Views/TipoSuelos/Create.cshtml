@model SistemaVeredas.Models.TipoSuelo

@{
    ViewData["Title"] = "Nuevo tipo de suelo";
}

<div class="mx-auto" style="max-width: 640px;">
    <a asp-action="Index" class="small text-decoration-none">&larr; Volver a la lista</a>
    <h1 class="h3 mb-1">Nuevo tipo de suelo</h1>
    <div class="mb-3"></div>

    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <section class="form-seccion">
            <div class="form-seccion-head">Datos de la baldosa</div>
            <div class="form-seccion-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Tipo" class="form-label"></label>
                        <input asp-for="Tipo" class="form-control" />
                        <span asp-validation-for="Tipo" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Medida" class="form-label"></label>
                        <input asp-for="Medida" class="form-control" />
                        <span asp-validation-for="Medida" class="text-danger"></span>
                    </div>
                    <div class="col-md-12">
                        <label asp-for="Color" class="form-label"></label>
                        <input asp-for="Color" class="form-control" />
                        <span asp-validation-for="Color" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <input class="form-check-input" asp-for="Disponible" />
                            <label class="form-check-label" asp-for="Disponible"></label>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <div class="d-flex justify-content-end gap-2 mb-4">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <input type="submit" value="Guardar tipo de suelo" class="btn btn-guardar" />
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
