@model SistemaVeredas.Models.Vereda

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Vereda</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Nombre" class="control-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Apellido" class="control-label"></label>
                <input asp-for="Apellido" class="form-control" />
                <span asp-validation-for="Apellido" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Calle" class="control-label"></label>
                <input asp-for="Calle" class="form-control" />
                <span asp-validation-for="Calle" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EntreCalle1" class="control-label"></label>
                <input asp-for="EntreCalle1" class="form-control" />
                <span asp-validation-for="EntreCalle1" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EntreCalle2" class="control-label"></label>
                <input asp-for="EntreCalle2" class="form-control" />
                <span asp-validation-for="EntreCalle2" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Altura" class="control-label"></label>
                <input asp-for="Altura" class="form-control" />
                <span asp-validation-for="Altura" class="text-danger"></span>
            </div>
            <partial name="_MapaUbicacion" model="Model" />
            <div class="form-group">
                <label asp-for="Observacion" class="control-label"></label>
                <input asp-for="Observacion" class="form-control" />
                <span asp-validation-for="Observacion" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FechaReclamo" class="control-label"></label>
                <input asp-for="FechaReclamo" class="form-control" />
                <span asp-validation-for="FechaReclamo" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FechaRelevo" class="control-label"></label>
                <input asp-for="FechaRelevo" class="form-control" />
                <span asp-validation-for="FechaRelevo" class="text-danger"></span>
            </div>
            <div class="form-group">
                @if (Model.ListaFotos.Any())
                {
                    <label class="control-label">Fotos actuales</label>
                    <div class="d-flex flex-wrap gap-2 mb-2">
                        @foreach (var foto in Model.ListaFotos)
                        {
                            <div class="border rounded p-1 text-center" style="width:110px">
                                <a href="~/@foto" target="_blank"><img src="~/@foto" class="img-fluid rounded" style="height:80px;object-fit:cover;width:100%" alt="Foto" /></a>
                                <label class="small d-block mt-1">
                                    <input type="checkbox" name="fotosAEliminar" value="@foto" /> Quitar
                                </label>
                            </div>
                        }
                    </div>
                }
                <label class="control-label" for="archivos">Agregar fotos</label>
                <input type="file" id="archivos" name="archivos" class="form-control" accept="image/*" multiple />
                <div class="form-text">Podés elegir varias fotos a la vez (jpg, png o webp, hasta 10 MB cada una). Desde el celular se abre la cámara o la galería.</div>
                <span asp-validation-for="Fotos" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Prioridad" class="control-label"></label>
                <select asp-for="Prioridad" class="form-control" asp-items="Html.GetEnumSelectList<Prioridad>()">
                    <option value="">-- Sin prioridad --</option>
                </select>
                <span asp-validation-for="Prioridad" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Estado" class="control-label"></label>
                <select asp-for="Estado" class="form-control" asp-items="Html.GetEnumSelectList<Estado>()"></select>
                <span asp-validation-for="Estado" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="ACargoFrentista" /> @Html.DisplayNameFor(model => model.ACargoFrentista)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="ProveedorId" class="control-label"></label>
                <select asp-for="ProveedorId" class="form-control" asp-items="ViewBag.ProveedorId">
                    <option value="">-- Sin proveedor --</option>
                </select>
                <span asp-validation-for="ProveedorId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PaqueteId" class="control-label"></label>
                <select asp-for="PaqueteId" class="form-control" asp-items="ViewBag.PaqueteId">
                    <option value="">-- Sin paquete --</option>
                </select>
                <span asp-validation-for="PaqueteId" class="text-danger"></span>
            </div>
            <partial name="_Medicion" model="Model" />
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

<partial name="_TipoSueloRapido" />

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/medicion-vereda.js" asp-append-version="true"></script>
}
