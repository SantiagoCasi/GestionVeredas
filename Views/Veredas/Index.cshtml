@model IEnumerable<SistemaVeredas.Models.Vereda>

@{
    ViewData["Title"] = "Veredas";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h1 class="h3 mb-0">Veredas <span class="text-muted fs-6">(@Model.Count())</span></h1>
    <div class="d-flex gap-2">
        <a asp-controller="Home" asp-action="Veredas" class="btn btn-outline-secondary btn-sm">Ver como tarjetas</a>
        <a asp-action="Create" class="btn btn-primary btn-sm">+ Nueva vereda</a>
    </div>
</div>

@{
    var cantMedidas = Model.Count(v => v.EstaMedida);
    var cantSinMedir = Model.Count() - cantMedidas;
    var paquetes = ViewData["Paquetes"] as List<SelectListItem> ?? new List<SelectListItem>();
}
<div class="row g-2 mb-3">
    <div class="col-12 col-md-6">
        <input id="filtroTexto" type="search" class="form-control" placeholder="Buscar por calle, vecino, proveedor o paquete…" />
    </div>
    <div class="col-12 col-md-3">
        <select id="filtroMedicion" class="form-select" aria-label="Filtrar por medición">
            <option value="">Medidas y sin medir</option>
            <option value="si">Medidas (@cantMedidas)</option>
            <option value="no">Sin medir (@cantSinMedir)</option>
        </select>
    </div>
    <div class="col-12 col-md-3">
        <select id="filtroEstado" class="form-select">
            <option value="">Todos los estados</option>
            @foreach (var e in Enum.GetValues<Estado>())
            {
                <option value="@e">@e.GetDisplayName()</option>
            }
        </select>
    </div>
</div>

@* Barra de acción: aparece cuando hay al menos una vereda marcada (RF-PAQ-08). *@
<div id="barraSeleccion" class="d-none bg-white border rounded-3 shadow-sm p-2 mb-3">
    <form id="formAgregarAPaquete" method="post" asp-action="AgregarAPaquete" class="d-flex flex-wrap align-items-center gap-2">
        <span class="fw-semibold contador-seleccion">0 seleccionadas</span>
        @if (paquetes.Any())
        {
            <select name="paqueteId" id="paqueteDestino" class="form-select form-select-sm w-auto" aria-label="Paquete">
                <option value="">Elegí un paquete…</option>
                @foreach (var p in paquetes)
                {
                    <option value="@p.Value">@p.Text</option>
                }
            </select>
            <button type="submit" class="btn btn-primary btn-sm btn-agregar-seleccion">Agregar al paquete…</button>
            <span id="errorPaquete" class="text-danger small"></span>
        }
        else
        {
            <span>Todavía no hay paquetes. <a asp-controller="Paquetes" asp-action="Create">Creá uno</a></span>
        }
    </form>
</div>

<div class="table-responsive bg-white rounded-3 shadow-sm">
    <table class="table table-hover align-middle mb-0 tabla-veredas">
        <thead class="table-light">
            <tr>
                <th style="width:2.5rem">
                    <input type="checkbox" id="seleccionarTodas" class="form-check-input" aria-label="Seleccionar todas" />
                </th>
                <th>Foto</th>
                <th>Dirección</th>
                <th>Vecino</th>
                <th>Estado</th>
                <th>Medición</th>
                <th>Reparación</th>
                <th>Paquete</th>
                <th>Reclamo</th>
                <th>Ubicación</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            var vecino = $"{item.Nombre} {item.Apellido}".Trim();
            var reparacion = item.ACargoFrentista
                ? "Frentista"
                : item.Proveedor == null ? "—" : $"{item.Proveedor.Nombre} {item.Proveedor.Apellido}".Trim();
            var texto = $"{item.Direccion} {item.EntreCalle1} {item.EntreCalle2} {vecino} {reparacion} {item.Paquete?.Nombre}".ToLower();

            var medida = item.EstaMedida;
            var totalesMedicion = string.Join(" · ", new[] { MedicionService.FormatearM2(item.TotalM2), MedicionService.FormatearM3(item.TotalCordonM3) }
                .Where(x => x != null));

            <tr class="fila-vereda" data-estado="@item.Estado" data-medida="@(medida ? "si" : "no")" data-texto="@texto">
                <td>
                    @if (item.PaqueteId == null)
                    {
                        <input type="checkbox" class="form-check-input sel-vereda" name="veredaIds" value="@item.Id"
                               form="formAgregarAPaquete" aria-label="@($"Elegir {item.Direccion}")" />
                    }
                    else
                    {
                        <input type="checkbox" class="form-check-input sel-vereda" disabled
                               title="@($"Ya está en «{item.Paquete?.Nombre}». Quitala de ese paquete para moverla.")"
                               aria-label="@($"{item.Direccion} ya está en un paquete")" />
                    }
                </td>
                <td>
                    @if (item.ListaFotos.Any())
                    {
                        <a asp-action="Details" asp-route-id="@item.Id">
                            <img src="~/@item.ListaFotos.First()" class="foto-mini" alt="Foto de @item.Direccion" loading="lazy" />
                        </a>
                        @if (item.ListaFotos.Count > 1)
                        {
                            <div class="small text-muted text-center">+@(item.ListaFotos.Count - 1)</div>
                        }
                    }
                    else
                    {
                        <div class="foto-mini foto-mini-vacia">Sin foto</div>
                    }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="fw-semibold text-decoration-none">@item.Direccion</a>
                    @if (!string.IsNullOrWhiteSpace(item.EntreCalle1) || !string.IsNullOrWhiteSpace(item.EntreCalle2))
                    {
                        <div class="small text-muted">entre @item.EntreCalle1 y @item.EntreCalle2</div>
                    }
                </td>
                <td>@(string.IsNullOrEmpty(vecino) ? "—" : vecino)</td>
                <td>
                    <span class="badge @item.Estado.BadgeClass()">@item.Estado.GetDisplayName()</span>
                    @if (item.Prioridad != null)
                    {
                        <div><span class="badge @item.Prioridad.BadgeClass() mt-1">@item.Prioridad.GetDisplayName()</span></div>
                    }
                </td>
                <td class="text-nowrap">
                    @if (medida)
                    {
                        <span class="badge text-bg-success">Medida</span>
                        <div class="small text-muted mt-1">@totalesMedicion</div>
                    }
                    else
                    {
                        <span class="badge text-bg-light border text-secondary">Sin medir</span>
                    }
                </td>
                <td>@reparacion</td>
                <td>@(item.Paquete?.Nombre ?? "—")</td>
                <td class="text-nowrap">@(item.FechaReclamo?.ToString("dd/MM/yyyy") ?? "—")</td>
                <td>
                    <partial name="_VistaMapa" model="item" view-data='new ViewDataDictionary(ViewData) { ["Modo"] = "mini" }' />
                </td>
                <td class="text-nowrap">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Ver</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Borrar</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
<div id="sinResultados" class="empty-state d-none mt-3">No hay veredas que coincidan con la búsqueda.</div>

@section Scripts {
    <script src="~/js/seleccion-veredas.js" asp-append-version="true"></script>
}
