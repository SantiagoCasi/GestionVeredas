@model SistemaVeredas.Models.Vereda

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Vereda</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Nombre)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Nombre)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Apellido)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Apellido)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Calle)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Calle)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.EntreCalle1)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.EntreCalle1)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.EntreCalle2)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.EntreCalle2)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Altura)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Altura)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Ubicacion)
        </dt>
        <dd class = "col-sm-10">
            <partial name="_VistaMapa" model="Model" />
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Observacion)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Observacion)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FechaReclamo)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FechaReclamo)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FechaRelevo)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FechaRelevo)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Fotos)
        </dt>
        <dd class = "col-sm-10">
            @if (Model.ListaFotos.Any())
            {
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var foto in Model.ListaFotos)
                    {
                        <a href="~/@foto" target="_blank">
                            <img src="~/@foto" class="rounded border" style="width:160px;height:120px;object-fit:cover" alt="Foto de la vereda" />
                        </a>
                    }
                </div>
            }
            else
            {
                <span class="text-muted">Sin fotos</span>
            }
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Prioridad)
        </dt>
        <dd class = "col-sm-10">
            @Model.Prioridad.GetDisplayName()
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Estado)
        </dt>
        <dd class = "col-sm-10">
            @Model.Estado.GetDisplayName()
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ACargoFrentista)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ACargoFrentista)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Proveedor)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Proveedor.Nombre)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Paquete)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Paquete.Nombre)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
