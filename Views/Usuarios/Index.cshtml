@model IEnumerable<SistemaVeredas.Models.ViewModels.UsuarioViewModel>

@{
    ViewData["Title"] = "Usuarios";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h1 class="h3 mb-0">Usuarios</h1>
    <a asp-action="Create" class="btn btn-guardar btn-sm">+ Nuevo usuario</a>
</div>

<div class="table-responsive bg-white rounded-3 shadow-sm">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                    <th>@Html.DisplayNameFor(model => model.UsApellido)</th>
                    <th>@Html.DisplayNameFor(model => model.UsNombre)</th>
                    <th>@Html.DisplayNameFor(model => model.UsEmail)</th>
                    <th>@Html.DisplayNameFor(model => model.UsActivo)</th>
                    <th>@Html.DisplayNameFor(model => model.UltimoAcceso)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
@foreach (var item in Model)
{
            <tr>
                <td>@Html.DisplayFor(modelItem => item.UsApellido)</td>
                <td>@Html.DisplayFor(modelItem => item.UsNombre)</td>
                <td>@Html.DisplayFor(modelItem => item.UsEmail)</td>
                <td>@if (item.UsActivo)
                    {
                        <span class="badge text-bg-primary">Activo</span>
                    }
                    else
                    {
                        <span class="badge text-bg-light border text-secondary">Inactivo</span>
                    }</td>
                <td>@Html.DisplayFor(modelItem => item.UltimoAcceso)</td>
                <td class="text-nowrap text-end">
                    <a asp-action="Details" asp-route-id="@item.UsId" class="btn btn-sm btn-outline-primary">Detalle</a>
                    <a asp-action="Edit" asp-route-id="@item.UsId" class="btn btn-sm btn-outline-secondary">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.UsId" class="btn btn-sm btn-outline-danger">Eliminar</a>
                </td>
            </tr>
}
        </tbody>
    </table>
</div>
@if (!Model.Any())
{
    <div class="empty-state mt-3">Todavía no hay usuarios.</div>
}
