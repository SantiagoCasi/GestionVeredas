@model SistemaVeredas.Models.ViewModels.UsuarioViewModel

@{
    ViewData["Title"] = "Eliminar usuario";
}

<div class="mx-auto" style="max-width: 640px;">
    <a asp-action="Index" class="small text-decoration-none">&larr; Volver a la lista</a>
    <h1 class="h3 mb-1">Eliminar usuario</h1>
    <p class="text-muted mb-3">¿Seguro que querés eliminar este usuario?</p>

    <section class="form-seccion">
        <div class="form-seccion-body py-2">
            <div class="dato-fila"><span class="k">@Html.DisplayNameFor(model => model.UsNombre)</span><span class="v">@Html.DisplayFor(model => model.UsNombre)</span></div>
            <div class="dato-fila"><span class="k">@Html.DisplayNameFor(model => model.UsApellido)</span><span class="v">@Html.DisplayFor(model => model.UsApellido)</span></div>
            <div class="dato-fila"><span class="k">@Html.DisplayNameFor(model => model.UsEmail)</span><span class="v">@Html.DisplayFor(model => model.UsEmail)</span></div>
            <div class="dato-fila"><span class="k">@Html.DisplayNameFor(model => model.UsActivo)</span><span class="v">@(Model.UsActivo ? "Sí" : "No")</span></div>
            <div class="dato-fila"><span class="k">@Html.DisplayNameFor(model => model.FechaCreacion)</span><span class="v">@Html.DisplayFor(model => model.FechaCreacion)</span></div>
            <div class="dato-fila"><span class="k">@Html.DisplayNameFor(model => model.UltimoAcceso)</span><span class="v">@Html.DisplayFor(model => model.UltimoAcceso)</span></div>
        </div>
    </section>

    <form asp-action="Delete" class="d-flex justify-content-end gap-2 mb-4">
        <input type="hidden" asp-for="UsId" />
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        <input type="submit" value="Eliminar" class="btn btn-danger" />
    </form>
</div>
