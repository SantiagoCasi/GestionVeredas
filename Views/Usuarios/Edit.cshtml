@model SistemaVeredas.Models.ViewModels.UsuarioEditViewModel

@{
    ViewData["Title"] = "Editar usuario";
}

<h1>Editar usuario</h1>

<h4>Usuario</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="UsId" />
            <div class="form-group mb-2">
                <label asp-for="UsNombre" class="control-label"></label>
                <input asp-for="UsNombre" class="form-control" />
                <span asp-validation-for="UsNombre" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="UsApellido" class="control-label"></label>
                <input asp-for="UsApellido" class="form-control" />
                <span asp-validation-for="UsApellido" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="UsEmail" class="control-label"></label>
                <input asp-for="UsEmail" type="email" class="form-control" />
                <span asp-validation-for="UsEmail" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="NuevaContrasena" class="control-label"></label>
                <input asp-for="NuevaContrasena" class="form-control" />
                <div class="form-text">Dejala vacía para no cambiarla. Entre 8 y 50 caracteres.</div>
                <span asp-validation-for="NuevaContrasena" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="ConfirmarContrasena" class="control-label"></label>
                <input asp-for="ConfirmarContrasena" class="form-control" />
                <span asp-validation-for="ConfirmarContrasena" class="text-danger"></span>
            </div>
            <div class="form-group form-check mb-2">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="UsActivo" /> @Html.DisplayNameFor(model => model.UsActivo)
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Guardar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Volver a la lista</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
