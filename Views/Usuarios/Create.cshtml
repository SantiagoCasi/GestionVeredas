@model SistemaVeredas.Models.ViewModels.UsuarioCreateViewModel

@{
    ViewData["Title"] = "Nuevo usuario";
}

<div class="mx-auto" style="max-width: 640px;">
    <a asp-action="Index" class="small text-decoration-none">&larr; Volver a la lista</a>
    <h1 class="h3 mb-1">Nuevo usuario</h1>
    <div class="mb-3"></div>

    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <section class="form-seccion">
            <div class="form-seccion-head">Datos del usuario</div>
            <div class="form-seccion-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="UsNombre" class="form-label"></label>
                        <input asp-for="UsNombre" class="form-control" />
                        <span asp-validation-for="UsNombre" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="UsApellido" class="form-label"></label>
                        <input asp-for="UsApellido" class="form-control" />
                        <span asp-validation-for="UsApellido" class="text-danger"></span>
                    </div>
                    <div class="col-md-12">
                        <label asp-for="UsEmail" class="form-label"></label>
                        <input asp-for="UsEmail" type="email" class="form-control" />
                        <span asp-validation-for="UsEmail" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="UsContrasena" class="form-label"></label>
                        <input asp-for="UsContrasena" class="form-control" />
                        <div class="form-text">Entre 8 y 50 caracteres.</div>
                        <span asp-validation-for="UsContrasena" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ConfirmarContrasena" class="form-label"></label>
                        <input asp-for="ConfirmarContrasena" class="form-control" />
                        <span asp-validation-for="ConfirmarContrasena" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <input class="form-check-input" asp-for="UsActivo" />
                            <label class="form-check-label" asp-for="UsActivo"></label>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <div class="d-flex justify-content-end gap-2 mb-4">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <input type="submit" value="Crear usuario" class="btn btn-guardar" />
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
