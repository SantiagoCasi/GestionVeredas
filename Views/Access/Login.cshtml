@model SistemaVeredas.Models.ViewModels.LoginViewModel
@{
    ViewBag.Title = "Iniciar sesión";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,
initial-scale=1.0" />
    <title>@ViewBag.Title - ISFDyT N°124</title>
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all
 .min.css" />
    <style>
        :root {
            --primary-color: darksalmon;
            --secondary-color: #f8f9fa;
            --error-color: #dc3545;
            --success-color: #28a745;
            --light-bg: #f8f9fa;
        }

        body {
            background: linear-gradient(135deg, #e6f0fa 0%, white 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container {
            max-width: 500px;
            animation: fadeIn 0.6s ease-out;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .card {
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
            overflow: hidden;
            border: none;
        }

        .card-header {
            background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
            color: white;
            padding: 25px;
            text-align: center;
            font-weight: 600;
            font-size: 1.8rem;
            border: none;
        }

        .card-body {
            padding: 35px;
            background-color: white;
        }

        .logo-container {
            text-align: center;
            margin-bottom: 25px;
        }

        .institute-logo {
            max-width: 300px;
            height: auto;
            margin-bottom: 10px;
            border: 1px solid black;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

            .logo-container img {
                max-width: 360px;
                height: auto;
            }

        .message-container {
            margin-bottom: 20px;
            border-radius: 8px;
            padding: 15px;
            text-align: center;
            font-weight: 500;
        }

        .success-message {
            background-color: #d4edda;
            color: #155724;
            border-left: 4px solid var(--success-color);
        }

        .error-message {
            background-color: #f8d7da;
            color: #721c24;
            border-left: 4px solid var(--error-color);
        }

        .form-group {
            margin-bottom: 25px;
        }

            .form-group label {
                font-weight: 600;
                color: #2c3e50;
                display: block;
                margin-bottom: 10px;
                font-size: 1.05rem;
                text-align: center;
            }

        .form-control {
            border-radius: 10px;
            padding: 14px 15px;
            border: 2px solid #e1e5ee;
            transition: all 0.3s;
            width: 100%;
            font-size: 1.05rem;
        }

            .form-control:focus {
                border-color: var(--primary-color);
                box-shadow: 0 0 0 0.25rem rgba(0, 77, 128, 0.25);
            }

        .btn-container {
            display: flex;
            justify-content: space-between;
            margin-top: 25px;
            gap: 15px;
        }

        .btn-primary {
            background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
            border: none;
            padding: 14px 20px;
            border-radius: 10px;
            font-weight: 600;
            transition: all 0.3s;
            flex: 1;
            font-size: 1.1rem;
        }

            .btn-primary:hover {
                transform: translateY(-3px);
                box-shadow: 0 7px 20px rgba(0, 77, 128, 0.3);
            }

        .btn-secondary {
            background: linear-gradient(90deg, #6c757d, #495057);
            border: none;
            padding: 14px 20px;
            border-radius: 10px;
            font-weight: 600;
            transition: all 0.3s;
            flex: 1;
            font-size: 1.1rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .btn-secondary:hover {
                transform: translateY(-3px);
                box-shadow: 0 7px 15px rgba(108, 117, 125, 0.3);
            }

        .icon-left {
            margin-right: 8px;
            transition: transform 0.3s;
        }

        .btn-secondary:hover .icon-left {
            transform: translateX(-3px);
        }

        @@media (max-width: 576px) {
            .btn-container {
                flex-direction: column;
            }

            .card-body {
                padding: 25px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="card">
            <div class="card-header text-center">
                <h3 class="m-0">Iniciar sesión</h3>
            </div>
            <div class="card-body">
                <form asp-action="Login" asp-controller="Access" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div class="form-group">
                        <label asp-for="UsEmail"></label>
                        <input asp-for="UsEmail" type="email" class="form-control" placeholder="ejemplo@gmail.com" autofocus />
                        <span asp-validation-for="UsEmail" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="UsContrasena"></label>
                        <input asp-for="UsContrasena" type="password" class="form-control" />
                        <span asp-validation-for="UsContrasena" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="Recordarme" class="form-check-input" />
                        <label asp-for="Recordarme" class="form-check-label"></label>
                    </div>

                    <div class="btn-container">
                        <a asp-controller="Access" asp-action="StartRecovery" class="btn btn-secondary">
                            <i class="fas fa-key icon-left"></i>
                            Olvidé mi contraseña
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-sign-in-alt me-2"></i> Ingresar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            @if (TempData["MensajeExito"] != null)
            {
                <text>
                    Swal.fire({
                        icon: 'success',
                        title: 'Listo',
                        text: '@Html.Raw(TempData["MensajeExito"])',
                        confirmButtonText: 'Aceptar'
                    });
                </text>
            }
        });
    </script>
</body>
</html>
