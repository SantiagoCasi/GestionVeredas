@model SistemaVeredas.Models.ViewModels.RecoveryViewModel
@{
    ViewBag.Title = "Recuperar contraseña";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - SistemaVeredas</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        :root {
            --primario: #1e4d8c;
            --primario-claro: #2f6fba;
            --oscuro: #12294d;
            --fondo: #f5f6f8;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            background: var(--fondo);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .login-hero {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 60px;
            color: #fff;
            background: linear-gradient(135deg, var(--primario), var(--oscuro));
        }

        .login-marca {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 1.4rem;
            font-weight: 700;
        }

        .login-marca i {
            width: 30px;
            height: 30px;
            border-radius: 8px;
            background: rgba(255, 255, 255, .25);
            display: inline-block;
        }

        .login-hero h1 { font-size: 2.2rem; margin: 30px 0 12px; }
        .login-hero p { opacity: .85; font-size: 1.1rem; max-width: 420px; }

        .login-panel {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .login-card {
            width: 100%;
            max-width: 400px;
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 2px 14px rgba(0, 0, 0, .08);
            padding: 34px;
            animation: fadeIn .6s ease-out;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(-20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .login-card h2 { font-size: 1.5rem; margin: 0 0 4px; }
        .login-card .form-label { font-size: .85rem; font-weight: 600; color: #495057; }
        .login-card .form-control { padding: 10px 12px; border-radius: 8px; }

        .login-card .form-control:focus {
            border-color: var(--primario-claro);
            box-shadow: 0 0 0 .2rem rgba(47, 111, 186, .2);
        }

        .btn-ingresar {
            width: 100%;
            padding: 11px;
            border: 0;
            border-radius: 8px;
            color: #fff;
            font-weight: 600;
            background: linear-gradient(135deg, var(--primario), var(--primario-claro));
        }

        .btn-ingresar:hover { color: #fff; filter: brightness(1.08); }
        .btn-volver { width: 100%; padding: 11px; border-radius: 8px; font-weight: 600; }
        .login-link { color: var(--primario); font-weight: 600; font-size: .85rem; text-decoration: none; }
        .login-link:hover { text-decoration: underline; }

        .aviso { border-radius: 8px; padding: 10px 14px; margin-bottom: 16px; font-size: .9rem; }
        .aviso-error { background: #f8d7da; color: #721c24; border-left: 4px solid #dc3545; }
        .aviso-ok { background: #e8f0fa; color: #163a6b; border-left: 4px solid var(--primario); }

        .campo-clave { position: relative; }
        .campo-clave .form-control { padding-right: 44px; }
        .btn-ojo { position: absolute; right: 8px; top: 50%; transform: translateY(-50%); background: transparent; border: 0; color: #6c757d; padding: 4px 8px; }

        .reglas { background: #f5f6f8; border-left: 4px solid var(--primario); border-radius: 8px; padding: 12px 14px; font-size: .9rem; }

        @@media (max-width: 768px) {
            .login-hero { display: none; }
        }
    </style>
</head>
<body>
    <div class="login-hero">
        <div class="login-marca"><i></i>SistemaVeredas</div>
        <h1>Gestión de reparaciones de veredas</h1>
        <p>Registrá, agrupá en paquetes y seguí el estado de cada vereda de Colón.</p>
    </div>

    <div class="login-panel">
        <div class="login-card">
            <h2>Recuperar contraseña</h2>
            <p class="text-muted mb-4">Te enviamos un correo para restablecerla.</p>
            @if (!string.IsNullOrEmpty(ViewBag.Error))
            {
                <div class="aviso aviso-error">@ViewBag.Error</div>
            }
            @if (!string.IsNullOrEmpty(ViewBag.Message))
            {
                <div class="aviso aviso-ok">@ViewBag.Message</div>
            }

            <form asp-action="StartRecovery" asp-controller="Access" method="post">
                <div class="mb-4">
                    <label for="UsEmail" class="form-label">Ingresá tu email registrado</label>
                    @Html.TextBoxFor(m => m.UsEmail, new {
                        @class = "form-control",
                        @placeholder = "ejemplo@gmail.com",
                        @type = "email",
                        @required = "required"
                    })
                    @Html.ValidationMessageFor(m => m.UsEmail, null, new { @class = "text-danger" })
                </div>

                <button type="submit" class="btn btn-ingresar mb-2">Recuperar contraseña</button>
                <a href="javascript:history.back()" class="btn btn-outline-secondary btn-volver">Volver</a>
            </form>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            @if (TempData["MensajeExito"] != null)
            {
                <text>
                    Swal.fire({
                        icon: 'success',
                        title: '¡Correo enviado!',
                        text: @Json.Serialize(TempData["MensajeExito"]),
                        confirmButtonText: 'Aceptar'
                    });
                </text>
            }
            @if (TempData["Error"] != null)
            {
                <text>
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: @Json.Serialize(TempData["Error"]),
                        confirmButtonText: 'Aceptar'
                    });
                </text>
            }
            @if (ViewBag.Error != null)
            {
                <text>
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: @Json.Serialize((string?)ViewBag.Error),
                        confirmButtonText: 'Aceptar'
                    });
                </text>
            }
        });
    </script>
</body>
</html>
