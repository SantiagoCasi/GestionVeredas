@model SistemaVeredas.Models.ViewModels.RecoveryPasswordViewModel
@{
    ViewBag.Title = "Restablecer Contraseña";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,
initial-scale=1.0" />
    <title>@ViewBag.Title - SistemaVeredas</title>
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all
 .min.css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>

        :root {
            --primary-color: darksalmon;
            --secondary-color: #f8f9fa;
            --error-color: #dc3545;
            --success-color: #28a745;
            --light-bg: #f8f9fa;
        }
        body {
        background: linear-gradient(135deg, #e6f0fa 0%, white
        100%);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana,
        sans-serif;
        }
        .container {
        max-width: 500px;
        animation: fadeIn 0.6s ease-out;
        }
        @@keyframes fadeIn {
        from {
        opacity: 0;
        transform: translateY(-20px);
        }
        to {
        opacity: 1;
        transform: translateY(0);
        }
        }
        .card {
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
        overflow: hidden;
        border: none;
        }
        .card-header {
        background: linear-gradient(90deg, var(--primary-color),
        var(--secondary-color));
        color: white;
        padding: 25px;
        text-align: center;
        font-weight: 600;
        font-size: 1.8rem;
        border: none;
        }
        .card-body {
        padding: 35px;
        background-color: white;
        }
        .logo-container {
        text-align: center;
        margin-bottom: 25px;
        }
        .logo-container img {
        max-width: 360px;
        height: auto;
        }
        .message-container {
        margin-bottom: 20px;
        border-radius: 8px;
        padding: 15px;
        text-align: center;
        font-weight: 500;
        }
        .success-message {
        background-color: #d4edda;
        color: #155724;
        border-left: 4px solid var(--success-color);
        }
        .error-message {
        background-color: #f8d7da;
        color: #721c24;
        border-left: 4px solid var(--error-color);
        }
        .form-group {
        margin-bottom: 25px;
        }
        .form-group label {
        font-weight: 600;
        color: #2c3e50;
        display: block;
        margin-bottom: 10px;
        font-size: 1.05rem;
        text-align: center;
        }
        .input-group {
        position: relative;
        }
        .input-icon {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: #6c757d;
        z-index: 10;
        }
        .form-control {
        border-radius: 10px;
        padding: 14px 15px 14px 48px;
        border: 2px solid #e1e5ee;
        transition: all 0.3s;
        width: 100%;
        font-size: 1.05rem;
        }
        .form-control:focus {
        border-color: var(--primary-color);
        box-shadow: 0 0 0 0.25rem rgba(0, 77, 128, 0.25);
        }
        .btn-toggle-password {
        position: absolute;
        right: 15px;
        top: 50%;
        transform: translateY(-50%);
        background: transparent;
        border: none;
        color: #6c757d;
        z-index: 10;
        padding: 5px;
        }
        .btn-primary {
        background: linear-gradient(90deg, var(--primary-color),
        var(--secondary-color));
        border: none;
        padding: 14px 20px;
        border-radius: 10px;
        font-weight: 600;
        transition: all 0.3s;
        width: 100%;
        font-size: 1.1rem;
        }
        .btn-primary:hover {
        transform: translateY(-3px);
        box-shadow: 0 7px 20px rgba(0, 77, 128, 0.3);
        }
        .btn-secondary {
        background: linear-gradient(90deg, #6c757d, #495057);
        border: none;
        padding: 14px 20px;
        border-radius: 10px;
        font-weight: 600;
        transition: all 0.3s;
        width: 100%;
        font-size: 1.1rem;
        margin-top: 10px;
        }
        .btn-secondary:hover {
        transform: translateY(-3px);
        box-shadow: 0 7px 15px rgba(108, 117, 125, 0.3);
        }
        .password-rules {
        background-color: #f8f9fa;
        border-radius: 8px;
        padding: 15px;
        margin-top: 15px;
        border-left: 4px solid var(--primary-color);
        font-size: 0.95rem;
        }
        .password-rules ul {
        padding-left: 20px;
        margin-bottom: 0;
        }
        .password-rules li {
        margin-bottom: 5px;
        }
        @@media (max-width: 576px) {
        .card-body {
        padding: 25px;
        }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="card">
            <div class="card-header text-center">
                <h3 class="m-0">Restablecer Contraseña</h3>
            </div>
            <div class="card-body">
                <!-- Mensajes de error o éxito -->
                @if (!string.IsNullOrEmpty(ViewBag.Error))
                {
                    <div class="message-container error-message">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        @ViewBag.Error
                    </div>
                }
                @if (!string.IsNullOrEmpty(ViewBag.Message))
                {
                    <div class="message-container success-message">
                        <i class="fas fa-check-circle me-2"></i>
                        @ViewBag.Message
                    </div>
                }

                <form asp-action="Recovery" asp-controller="Access"
                      method="post">
                    @Html.HiddenFor(m => m.token)

                    <div class="form-group">
                        <label for="UsContrasena">
                            Nueva
                            Contraseña
                        </label>
                        <div class="input-group">
                            <i class="fas fa-lock input-icon"></i>
                            <input type="password"
                                   id="UsContrasena"
                                   asp-for="UsContrasena"
                                   class="form-control"
                                   placeholder="Ingrese su nueva contraseña"
                                   required />
                            <button type="button"
                                    class="btn-toggle-password" onclick="togglePassword('UsContrasena','eyeIcon1')">
                                <i id="eyeIcon1" class="fas fa-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="UsContrasena"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label for="UsContrasena2">
                            Confirmar
                            Contraseña
                        </label>
                        <div class="input-group">
                            <i class="fas fa-lock input-icon"></i>
                            <input type="password"
                                   id="UsContrasena2"
                                   asp-for="UsContrasena2"
                                   class="form-control"
                                   placeholder="Confirme su nueva contraseña"
                                   required />
                            <button type="button"
                                    class="btn-toggle-password" onclick="togglePassword('UsContrasena2','eyeIcon2')">
                                <i id="eyeIcon2" class="fas fa-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="UsContrasena2"
                              class="text-danger"></span>
                    </div>

                    <div class="password-rules">
                        <strong>Requisitos de la contraseña:</strong>
                        <ul>
                            <li>Entre 8 y 50 caracteres.</li>
                        </ul>
                    </div>

                    <button type="submit" class="btn btn-primary mt-3">
                        <i class="fas fa-key me-2"></i> Restablecer
                        Contraseña
                    </button>

                    <a asp-controller="Access" asp-action="Login"
                       class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-2"></i> Volver
                        al Login
                    </a>
                </form>
            </div>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script>

        function togglePassword(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (input.type === "password") {
                input.type = "text";
                icon.classList.replace("fa-eye", "fa-eye-slash");
                } 
            else {
                input.type = "password";
                icon.classList.replace("fa-eye-slash", "fa-eye");
                }
        }

        document.addEventListener('DOMContentLoaded', function () {
            @if (TempData["Error"] != null)
            {
                <text>
                Swal.fire({
                title: 'Error',
                text: @Json.Serialize(TempData["Error"]),
                icon: 'error',
                confirmButtonText: 'Aceptar'
                });
                </text>
            }
            });
    </script>
</body>
</html>

